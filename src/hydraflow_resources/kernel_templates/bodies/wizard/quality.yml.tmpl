name: Quality

on:
  pull_request:
  push:
    branches: [{{main_branch}}, {{staging_branch}}]

jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: uv sync --all-extras
      - run: uv run ruff check --fix --unsafe-fixes src tests scripts
      - run: make quality
