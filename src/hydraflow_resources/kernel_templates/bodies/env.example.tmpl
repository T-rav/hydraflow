# {{title}} — environment configuration
# Domain-specific variables belong at the top of this block.
LOG_LEVEL=INFO

# --- Exception sensor (ADR-0146) ---
# Errors leave this app, become issues on the tracker, and re-enter the factory
# as work it can triage. See docs/standards/exception_sensor/RUNBOOK.md for how
# to initialise the SDK; the rules are in that directory's README.
#
# The client is the Sentry SDK, so this can name ANY Sentry-protocol endpoint.
# Bugsink is the house default because it is self-hosted. PRESENCE OF THE DSN IS
# THE SWITCH: unset means nothing is reported, which is what tests and CI want.
# SENTRY_DSN=http://<key>@localhost:8000/<project-id>
#
# Overrides a configured DSN, always toward OFF.
# HYDRAFLOW_SENTRY_DISABLED=1
