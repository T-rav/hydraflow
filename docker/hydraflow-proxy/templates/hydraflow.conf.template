# Exposes the issue-logging surface, and nothing else.
#
# HydraFlow's dashboard has NO in-process authentication. ADR-0138 §D5 records
# that its operator boundary IS the loopback socket bind, and ADR-0140 confirms
# only one route ever gained a credential of its own: of ~169 dashboard routes,
# 8 mention the operator token. Publishing the dashboard would therefore not
# expose "the UI" — it would expose the control plane, unauthenticated.
#
# So this proxy is default-deny, and opens two ISOLATED lanes onto the single
# intake method. The application keeps one handler; the separation is here:
#
#   /exception/<token>  -> /api/issues/intake?source=bugsink
#   /report/<token>     -> /api/issues/intake?source=ui
#
# Why isolate lanes rather than expose the intake directly:
#
#   * `source` is PINNED per lane (`set $args`), so a caller cannot choose its
#     own provenance. Passing the intake through untouched would let anyone
#     holding the report token file an issue labelled as a system exception,
#     and triage treats those differently — it auto-closes the ones that fail.
#   * The two tokens rotate independently. Re-keying Bugsink does not disturb
#     the UI, and a leaked report token buys nothing on the exception lane.
#   * Each lane gets its own rate limit. An error storm on the exception lane
#     cannot exhaust the budget the UI needs, and neither can flood the board.
#
# Substitution is restricted to HF_-prefixed variables (NGINX_ENVSUBST_FILTER),
# so nginx's own $host / $remote_addr / $args survive the template pass.

upstream hydraflow_dashboard {
    server ${HF_UPSTREAM};
}

# Separate zones, so one lane's burst cannot starve the other.
limit_req_zone $binary_remote_addr zone=hf_exception:1m rate=${HF_EXCEPTION_RATE};
limit_req_zone $binary_remote_addr zone=hf_report:1m rate=${HF_REPORT_RATE};

server {
    listen 8443 ssl;
    http2 on;
    server_name ${HF_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;
    client_max_body_size 1m;

    # Default deny. Anything not named below does not exist as far as the
    # network is concerned — including /api/issues/intake itself, which is
    # deliberately NOT reachable directly: reaching it would mean choosing
    # your own `source`.
    location / {
        return 404;
    }

    # --- Lane 1: the exception sensor -------------------------------------
    # Bugsink's alert config is a bare URL — no signing secret, no auth header —
    # so this lane trades its path token for the ADR-0140 bearer.
    location = /exception/${HF_EXCEPTION_PATH_TOKEN} {
        limit_except POST {
            deny all;
        }
        limit_req zone=hf_exception burst=${HF_EXCEPTION_BURST} nodelay;

        set $args source=bugsink;
        proxy_set_header Authorization "Bearer ${HF_OPERATOR_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://hydraflow_dashboard/api/issues/intake;
    }

    # --- Lane 2: people and the UI ----------------------------------------
    location = /report/${HF_REPORT_PATH_TOKEN} {
        limit_except POST {
            deny all;
        }
        limit_req zone=hf_report burst=${HF_REPORT_BURST} nodelay;

        set $args source=ui;
        proxy_set_header Authorization "Bearer ${HF_OPERATOR_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://hydraflow_dashboard/api/issues/intake;
    }
}
