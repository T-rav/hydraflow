# Turns Bugsink's URL-token webhook into an ADR-0140 bearer call.
#
# Bugsink's alert config is a bare URL — no signing secret, no auth header — so
# it cannot present the operator token the intake boundary requires. Rather than
# give the application a second credential path (a URL token is weaker, and the
# first draft of this feature invented one that the ADR-0085 scrubber could not
# even redact), the concession lives here at the edge:
#
#   Bugsink  --POST /hook/{token}-->  proxy  --Bearer hfop_...-->  HydraFlow
#
# The proxy adds the header and nothing else reaches the app unauthenticated.
{
	admin off
	auto_https off
}

:8081 {
	# Exactly one route. Anything else is a 404, including a GET on this path:
	# an endpoint that answers differently to a probe is an endpoint a prober
	# can map.
	@webhook {
		method POST
		path /hook/{$BUGSINK_WEBHOOK_PATH_TOKEN}
	}
	handle @webhook {
		rewrite * /api/issues/intake?source=bugsink
		reverse_proxy {$HYDRAFLOW_INTAKE_UPSTREAM} {
			header_up Authorization "Bearer {$HYDRAFLOW_OPERATOR_TOKEN}"
			# The client's own Authorization/X-Forwarded auth must never
			# survive into the upstream call — the bearer above is the only
			# identity this hop asserts.
			header_up -Cookie
		}
	}
	handle {
		respond "Not Found" 404
	}
}
