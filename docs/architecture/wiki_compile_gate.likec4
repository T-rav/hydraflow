// Issue #11409 — the #11373 wiki fingerprint gate's seam: the MockWorld
// scenario layer that was missing, and the Fake that had drifted
// keyword-only underneath it. Both were resolved (by #11416, #11432, and
// this issue's own fix); this diagram records the seam as it now stands.
specification {
  element system
  element container
  element component
  element klass
  relationship calls
  relationship reads
  relationship stands_in_for
}

model {
  hydraflow = system 'HydraFlow' {

    loops = container 'Caretaker loops' {
      repoWikiLoop = component 'RepoWikiLoop' {
        description 'src/repo_wiki_loop.py — Phase 1/2/8 lint + compile'
      }
      lintCompile = component '_lint_and_compile_repos' {
        description 'src/repo_wiki_loop.py:293 — per-repo tick body'
      }
    }

    gate = container 'Fingerprint gate (#11373)' {
      compileState = klass 'WikiCompileState' {
        description 'src/wiki_compile_state.py — slug:topic:layout -> sha256'
      }
      fingerprint = klass 'topic_fingerprint' {
        description 'src/wiki_compile_state.py — order-normalized content hash'
      }
      stateFile = component 'wiki_compile_state.json' {
        description 'config.data_path() — outside the ephemeral wiki worktree'
      }
    }

    synth = container 'Synthesis seam (the expensive one)' {
      realCompiler = klass 'WikiCompiler' {
        description 'src/wiki_compiler.py:658 compile_topic_tracked(tracked_root, repo, topic, *, other_topics)'
      }
      fakeCompiler = klass 'FakeWikiCompiler' {
        description 'src/mockworld/fakes/fake_wiki_compiler.py:42 — was keyword-only (broke the seam); fixed positional-or-keyword by #11416/#11409'
      }
    }

    tests = container 'Test pyramid' {
      unitLayer = component 'tests/test_wiki_compile_state.py' {
        description 'Layer 1 — pure-function unit (shipped by PR #11375)'
      }
      regLayer = component 'tests/regressions/test_wiki_compile_churn_11373.py' {
        description 'Layer 1.5 — MagicMock deps, tracked_root=None (LEGACY path only)'
      }
      scenarioLayer = component 'tests/scenarios/test_wiki_evolution_scenarios.py' {
        description 'Layer 2 pointer — the multi-tick MockWorld proof lives in tests/scenarios/test_repo_wiki_compile_scenario.py (added by #11432)'
      }
      conformance = component 'tests/test_mockworld_fakes_conformance.py' {
        description 'Port<->Fake signature guard — WikiCompiler/FakeWikiCompiler pair added, checks param KIND (#11409)'
      }
      catalog = component 'tests/scenarios/catalog/loop_registrations.py' {
        description '_build_repo_wiki — wires the wiki_compiler port so MockWorld reaches the compile phase (fixed by #11416)'
      }
    }
  }

  repoWikiLoop -> lintCompile 'tick'
  lintCompile -> compileState 'should_compile / record / save'
  lintCompile -> fingerprint 'hash active entry bytes'
  compileState -> stateFile 'load + best-effort persist'
  lintCompile -> realCompiler 'compile_topic_tracked(tracked_root, slug, topic) — POSITIONAL'
  fakeCompiler -> realCompiler 'stands in for (signature must match)'

  unitLayer -> compileState 'covers'
  regLayer -> lintCompile 'covers legacy branch only'
  scenarioLayer -> lintCompile 'covers tracked branch across ticks (added by #11432)'
  scenarioLayer -> fakeCompiler 'needs a callable Fake at the seam'
  catalog -> repoWikiLoop 'builds for MockWorld'
  conformance -> fakeCompiler 'guards param KIND (added by #11409)'
}

views {
  view gateContext {
    title 'Fingerprint gate + the seam the scenario layer must cross'
    include *
  }

  dynamic view tickFlow {
    title 'Two ticks through the gate (the behaviour the missing layer pins)'

    repoWikiLoop -> lintCompile 'tick 1'
    lintCompile -> fingerprint 'hash 6 active entry files'
    lintCompile -> compileState 'should_compile(slug:topic:tracked, fp) -> True'
    lintCompile -> realCompiler 'compile_topic_tracked(...) — one LLM spawn'
    lintCompile -> compileState 'record(POST-compile fingerprint)'
    compileState -> stateFile 'save (dirty)'

    repoWikiLoop -> lintCompile 'tick 2 — content unchanged'
    lintCompile -> fingerprint 'same hash'
    lintCompile -> compileState 'should_compile -> False'
    compileState -> stateFile 'save() no-op — idle tick writes nothing'
  }
}
