// Issue #10499 — dynamic view of the mis-detection, traced against the REAL
// escaped commit 055267e7b2b7 ("fix(adr): single-colon ADR-0049 citations…").
//
// That commit ADDS tests/regressions/test_issue_10440.py, so `_classify`'s
// decided precedence (revert > regression-pin > hotfix > bug-issue) should
// yield regression-pin / medium confidence — which NEVER reaches the
// low-confidence HITL surface. Instead the ledger recorded bug-issue / low
// and filed issue #10499 asking a human to finish the attribution by hand.
//
// Reproduced read-only against the live repo:
//   _added_paths_for_range(repo, '055267e7b2b7^..055267e7b2b7') -> {}
//   commits_for_range(...)[0].added_paths                       -> ()
//   detect_escapes(...)[0]  -> bug-issue / low / fixes-chain
//
// Blast radius: added_paths is () for EVERY commit in EVERY range, so the
// regression-pin detection source is unreachable dead code in production and
// every regression-pin commit degrades into a spurious low-confidence HITL
// issue — the over-filing failure mode escape_ledger_loop's own docstring
// warns about.

specification {
  element step
  element boundary

  tag broken
  tag expected
  tag actual
}

model {
  pipeline = boundary 'Escape detection tick' {

    s1 = step 'git log --diff-filter=A --name-only --pretty=format:\\x1eESCSHA\\x1e%H' {
      description 'stdout: "\\x1eESCSHA\\x1e055267e7…\\ntests/regressions/test_issue_10440.py"'
    }
    s2 = step 'out.splitlines()' {
      #broken
      description 'Python treats 0x1c, 0x1d, 0x1e, 0x85, U+2028, U+2029 as line boundaries in addition to \\n. Result: ["", "ESCSHA", "055267e7…", "tests/regressions/test_issue_10440.py"]'
    }
    s3 = step 'line.startswith(_SHA_MARKER)' {
      #broken
      description 'never matches any shredded fragment -> current stays None -> every path line is dropped'
    }
    s4 = step '_added_paths_for_range returns {}' {
      #broken
    }
    s5 = step 'CommitInfo(added_paths=())' {
      #broken
    }
    s6 = step 'attribution.adds_regression_pin(())' {
      description 'False — always'
    }
    s7actual = step 'ACTUAL: EscapeCandidate(bug-issue, fixes-chain, low)' {
      #actual
      description 'falls through _classify to the _fix_subject branch; low confidence -> low_confidence() -> select_findings_to_surface -> create_issue -> #10499'
    }
    s7expected = step 'EXPECTED: EscapeCandidate(regression-pin, regression-pin, medium)' {
      #expected
      description 'medium confidence is NOT low_confidence(), so no HITL issue is filed for it at all'
    }
  }

  pipeline.s1 -> pipeline.s2 'parse stdout'
  pipeline.s2 -> pipeline.s3 'per line'
  pipeline.s3 -> pipeline.s4 'no marker ever matched'
  pipeline.s4 -> pipeline.s5 'added_map.get(sha, [])'
  pipeline.s5 -> pipeline.s6 'regression-pin signal'
  pipeline.s6 -> pipeline.s7actual 'False -> next precedence branch'
  pipeline.s1 -> pipeline.s7expected 'what a marker-safe parse yields'
}

views {
  view detectionFlow of pipeline {
    title '#10499 — how a regression-pin commit degrades into a low-confidence bug-issue HITL row'
    include *
  }
}
