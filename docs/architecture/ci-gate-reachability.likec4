// Issue #11164 — sampled re-audit of PR #11154 (upheld).
// ARCH-0001 declares ledger immutability "Enforced by: make console-conformance"
// (its era's name — ARCH-0003 renamed the target to `council-conformance`
// on 2026-08-25 and kept the old one as a deprecated alias).
// #11110 wired that command as a STEP of the `audit` job. The step exists; the
// job never fires for the change class it guards.
//
// WAS: `audit` was gated on core_python || ci. core_python's brace-glob is
//   {src/**/*.py,tests/**,pyproject.toml,uv.lock,scripts/**,docs/wiki/**,prompts/**,control/**}
// and has NO agents/** entry. The ledger lives at agents/council/decisions/**.
// Only the separate `python` output lists agents/** — and `python` gates only
// lint/typecheck/security, none of which execute pytest or the make target.
// Net: a PR that rewrote a merged decision record ran ZERO ledger checks.
//
// LANDED: a dedicated `council_ledger` filter (agents/**) OR'd into the
// `audit` job's if:. `make council-conformance` runs all six ARCH-0001 checks
// (shape, numbering, personas, chairs, staleness, git immutability) on the
// full clone the audit job already takes, so one gate closes both halves.

specification {
  element workflow
  element filterStep
  element output
  element job
  element step
  element artifact
  relationship gates
  relationship reads
  relationship covers
  relationship misses
}

model {
  ledger = artifact 'agents/council/decisions/**' {
    description 'ARCH-0001 chamber decision records — the immutable ledger'
  }

  ci = workflow '.github/workflows/ci.yml' {

    changes = job 'changes (dorny/paths-filter)' {

      filterDefault = filterStep 'step id: filter  (quantifier: some)' {
        outPython = output 'python' {
          description 'src/**/*.py, tests/**, scripts/**, docs/wiki/**, control/**, prompts/**, AGENTS/** '
        }
        outCi = output 'ci' {
          description '.github/workflows/**'
        }
        outArch = output 'arch' {
          description 'src/arch/**, tests/architecture/**, docs/arch/**, docs/adr/**, Makefile'
        }
        // LANDED (#11164): the surgical addition.
        outCouncil = output 'council_ledger  [ADDED #11164]' {
          description "agents/** — the ARCH-0001 ledger + persona contracts"
        }
      }

      filterCore = filterStep 'step id: core_filter  (quantifier: every)' {
        outCore = output 'core_python' {
          description 'brace-glob include minus arch/regressions/scenarios negations — NO agents/**'
        }
      }
    }

    lint = job 'lint / typecheck / security' {
      description 'ruff, pyright, bandit — never executes pytest or a make gate'
    }

    test = job 'test (Tests)' {
      description 'the pytest lane'
      tConformance = step 'tests/test_council_conformance.py' {
        description 'collect_errors(check_git=False) — shape/numbering/chairs only, immutability deliberately skipped'
      }
    }

    audit = job 'audit (Principles Audit)' {
      description 'if: core_python || ci || council_ledger  [#11164]; checkout fetch-depth: 0'
      sAudit = step 'make audit'
      sConf = step 'make council-conformance  [#11110]' {
        description 'scripts/check_council_conformance.py — all six checks incl. git-history immutability'
      }
    }

    arch = job 'arch (Architecture Check)' {
      description 'ALSO has fetch-depth: 0 — so the #11110 comment claiming `audit` uniquely does is false'
    }
  }

  // ---- pre-existing wiring ----
  ledger -> outPython 'matches agents/**' {
    title 'covered'
  }
  ledger -> outCore 'NO agents/** in the brace-glob' {
    title 'MISSED'
  }
  outPython -> lint 'gates'
  outCore -> test 'gates'
  outCore -> audit 'gates'
  outCi -> audit 'gates'
  outArch -> arch 'gates'
  sConf -> ledger 'reads (only if the job runs)'
  tConformance -> ledger 'reads with check_git=False'

  // ---- LANDED wiring (#11164) ----
  ledger -> outCouncil 'matches agents/**  [LANDED]'
  outCouncil -> audit 'gates  [LANDED: ORed into the if:]'
}

views {
  view ciGateReachability {
    title 'CI gate reachability for the ARCH-0001 ledger (#11164)'
    include *
    include ci.changes.*
    include ci.changes.filterDefault.*
    include ci.changes.filterCore.*
    include ci.audit.*
    include ci.test.*
    autoLayout LeftRight
  }

  dynamic view ledgerOnlyPr {
    title 'Ledger-only PR before #11164: every ARCH-0001 check was unreachable'
    ledger -> outPython 'agents/council/decisions/0001-*.md changed -> python=true'
    outPython -> lint 'lint/typecheck/security run (no ledger check)'
    ledger -> outCore 'core_python=false (no agents/** entry)'
    outCore -> test 'SKIPPED -> test_council_conformance.py never runs'
    outCore -> audit 'SKIPPED -> make council-conformance never runs'
    sConf -> ledger 'immutability check never executed -> PR merges green'
  }
}
