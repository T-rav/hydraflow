// Issue #10404 — Erosion: `existing_ids` scattered across audit/escape/intervention.
// Extended #10403 (split) / #10451 (this diagram): `append` + `read_all` were ALSO
// reimplemented by TrendStore (src/erosion/trends.py), the fourth append-only store.
// TrendStore's row type `ChangeDatapoint` has NO stable per-row id, so it cannot join
// the dedup base. Fix: split the single JsonlLedger[T] into a TWO-TIER hierarchy —
//   AppendOnlyJsonlLedger[S]  — path/read_all/append              (PLAIN tier; S: JsonlRow)
//   IdentifiedJsonlLedger[T]  — adds existing_ids(); extends ↑    (DEDUP  tier; T: Recordable)
// TrendStore joins the PLAIN tier; the three id-bearing ledgers join the DEDUP tier.
//
// #10403 has landed on staging: src/jsonl_ledger.py now defines AppendOnlyJsonlLedger /
// IdentifiedJsonlLedger, and TrendStore/AuditSampleLedger/EscapeLedger/InterventionLedger
// all subclass accordingly. The TO-BE view below matches shipped code, not a future target.

specification {
  element module
  element klass
  element method
  element loop
  relationship uses
  relationship extends
}

model {
  // ---- AS-IS: four stores each reimplementing read_all / append (± existing_ids) ----
  audit = module 'audit' {
    auditStore = klass 'AuditSampleLedger (src/audit/store.py)' {
      description 'read_all + existing_ids + append + update_dispositions'
      m_ids_a = method 'existing_ids() -> set[str]  [FLAGGED]'
    }
    auditModel = klass 'AuditSample (id, from_json_dict, to_json_dict)'
  }
  escape = module 'escape' {
    escapeLedger = klass 'EscapeLedger (src/escape/ledger.py)' {
      description 'read_all + existing_ids + append'
      m_ids_e = method 'existing_ids() -> set[str]  [FLAGGED]'
    }
    escapeModel = klass 'EscapeRecord (id, from_json_dict, to_json_dict)'
  }
  intervention = module 'intervention' {
    ivLedger = klass 'InterventionLedger (src/intervention/ledger.py)' {
      description 'read_all + existing_ids + append'
      m_ids_i = method 'existing_ids() -> set[str]  [FLAGGED]'
    }
    ivModel = klass 'InterventionRecord (id, from_json_dict, to_json_dict)'
  }
  // TrendStore — fourth append-only store; predates the base, reimplements read_all+append.
  // No stable id -> cannot dedup -> this is what drove the two-tier split.
  erosion = module 'erosion' {
    trendStore = klass 'TrendStore (src/erosion/trends.py)' {
      description 'read_all + append; NO existing_ids (ChangeDatapoint has no id)'
    }
    cdModel = klass 'ChangeDatapoint (from_json_dict, to_json_dict; NO id)'
  }

  // ---- Callers (dedup-on-tick + read) ----
  escapeLoop = loop 'EscapeLedgerLoop'          { -> escapeLedger uses 'existing_ids() for dedup' }
  auditLoop  = loop 'SampledAuditLoop'          { -> auditStore uses 'existing_ids() for dedup' }
  ivLoop     = loop 'InterventionTallyLoop'     { -> ivLedger uses 'existing_ids() for dedup' }
  sentry     = loop 'SentryLoop'                { -> escapeLedger uses 'existing_ids()' }
  vitals     = loop 'vitals.observe'            {
    -> escapeLedger uses 'read_all()'
    -> trendStore uses 'read_all() -> compute_monthly_trends'
  }

  auditStore -> auditModel uses
  escapeLedger -> escapeModel uses
  ivLedger -> ivModel uses
  trendStore -> cdModel uses

  // ---- TO-BE: two-tier shared base (neutral top-level infra, src/jsonl_ledger.py) ----
  shared = module 'shared-infra' {
    rowProto = klass 'JsonlRow Protocol (to_json_dict, from_json_dict)'
    idProto  = klass 'Recordable Protocol (JsonlRow + id())'
    appendBase = klass 'AppendOnlyJsonlLedger[S]  NEW' {
      description 'path + read_all + append defined ONCE; PLAIN tier; S bound by JsonlRow'
    }
    identBase = klass 'IdentifiedJsonlLedger[T]  NEW' {
      description 'adds existing_ids(); DEDUP tier; extends AppendOnly; T bound by Recordable'
      m_ids_base = method 'existing_ids() -> set[str]  [single definition]'
    }
  }
  idProto -> rowProto extends 'Recordable = JsonlRow + id'
  identBase -> appendBase extends 'dedup tier extends plain tier'
  appendBase -> rowProto uses 'S: JsonlRow'
  identBase -> idProto uses 'T: Recordable'

  // PLAIN tier member (no id):
  trendStore -> appendBase extends 'subclasses AppendOnlyJsonlLedger[ChangeDatapoint]'
  // DEDUP tier members (id-bearing) — rebased from the old single JsonlLedger[T]:
  auditStore -> identBase extends 'IdentifiedJsonlLedger[AuditSample]; keeps update_dispositions'
  escapeLedger -> identBase extends 'IdentifiedJsonlLedger[EscapeRecord]'
  ivLedger -> identBase extends 'IdentifiedJsonlLedger[InterventionRecord]'
}

views {
  view asis {
    title 'AS-IS — read_all/append reimplemented across 4 stores (existing_ids across 3)'
    include audit, escape, intervention, erosion,
            escapeLoop, auditLoop, ivLoop, sentry, vitals, *
  }
  view tobe {
    title 'TO-BE — two-tier base: AppendOnly (plain, +TrendStore) + Identified (dedup, x3)'
    include shared, audit, escape, intervention, erosion,
            appendBase, identBase, rowProto, idProto,
            auditStore, escapeLedger, ivLedger, trendStore, cdModel, *
  }
}
