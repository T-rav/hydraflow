// Issue #10565 — nudge path must mirror LIVE-ADR drift suppression.
// Topology of the ADR-drift subsystem around `bare_infra_citation_nudges`.

specification {
  element system
  element module
  element func
  element artifact
  element datastore
  relationship calls
  relationship reads
  relationship emits
}

model {
  adrCorpus = datastore 'docs/adr/*.md' {
    description 'ADR markdown corpus. Statuses: Accepted | Proposed | Superseded | Deprecated | Unknown.'
  }

  driftSystem = system 'ADR touchpoint drift (ADR-0056)' {

    index = module 'src/adr_index.py' {
      description 'Parses the ADR corpus into ADR records (number, status, source_files, source_symbols).'

      adrs = func 'ADRIndex.adrs()' {
        description 'Full corpus, every status. Mtime-cached.'
      }
      adrsTouching = func 'ADRIndex.adrs_touching(paths)' {
        description 'LIVE GATE: filters to status in (Accepted, Proposed) before path matching. The only status filter in the suppression path.'
      }
      isLive = func 'ADR.is_live / LIVE_ADR_STATUSES' {
        description 'Single source of truth for "live ADR" (#10565). Backs adrs_touching, adr_citation_resolve, and the nudge filter.'
      }
    }

    drift = module 'src/adr_drift.py' {
      description 'Pure citation-intersection logic. No I/O.'

      computeDrift = func 'compute_drift()' {
        description 'Reaches ADRs ONLY via adrs_touching -> live-only by construction.'
      }
      fanout = func '_bare_citation_fanout(path, adrs)' {
        description 'Counts bare citers of a path. Live-only on both the drift path and the nudge path (#10565 fixed the nudge path denominator to match).'
      }
      isSharedInfra = func '_is_shared_infra(path, fanout, threshold)' {
        description 'Shared predicate: manual _SHARED_INFRA_MODULES allowlist OR fan-out >= threshold.'
      }
      citationDrifts = func '_citation_drifts(adr, path, ...)' {
        description 'Bare citation drifts unless _is_shared_infra; symbol-qualified drifts only on symbol evidence.'
      }
      nudges = func 'bare_infra_citation_nudges(adrs)' {
        description 'Filters to live ADRs before iterating (#10565 fix), matching adrs_touching -> fires on exactly the bare citations suppression covers.'
      }
    }

    resolve = module 'src/adr_citation_resolve.py' {
      description 'Third copy of the (Accepted, Proposed) literal - folds into ADR.is_live.'
    }

    generator = module 'src/arch/generators/adr_cross_reference.py' {
      renderNudges = func '_render_symbol_granularity_nudges(adrs)' {
        description 'Passes the FULL corpus (all statuses) straight through to the nudge function.'
      }
    }

    runner = module 'src/arch/runner.py' {
      description 'make arch-regen -> emits docs/arch/generated/*.md; CI fails on stale artifacts.'
    }

    auditorLoop = module 'src/adr_touchpoint_auditor_loop.py' {
      description 'Caretaker loop that files per-ADR / fleet drift rollups from compute_drift.'
    }
  }

  xref = artifact 'docs/arch/generated/adr_xref.md' {
    description 'Shipped artifact. Symbol-Granularity Nudges table previously carried 5 rows for Superseded ADRs (0006, 0013 x2, 0033, 0036) before #10565 filtered them out.'
  }

  index -> adrCorpus 'reads'
  computeDrift -> adrsTouching 'calls'
  computeDrift -> fanout 'calls (live adrs only)'
  computeDrift -> citationDrifts 'calls'
  citationDrifts -> isSharedInfra 'calls'
  nudges -> isSharedInfra 'calls'
  nudges -> fanout 'calls (live-only)'
  adrsTouching -> isLive 'calls'
  resolve -> isLive 'calls'
  nudges -> isLive 'calls'
  renderNudges -> nudges 'calls'
  renderNudges -> adrs 'receives full corpus'
  runner -> renderNudges 'calls'
  runner -> xref 'emits'
  auditorLoop -> computeDrift 'calls'
}

views {
  view context {
    title 'ADR-drift: suppression path vs nudge path'
    include *
  }

  view driftInternals of driftSystem {
    title 'Where the live-status filter is enforced (post-#10565)'
    include *
    style nudges {
      color green
    }
    style adrsTouching {
      color green
    }
  }

  dynamic view nudgeFlowPreFix {
    title 'Nudge generation flow — the escape (historical, pre-#10565; fixed below)'
    runner -> renderNudges 'arch-regen'
    renderNudges -> adrs 'full corpus (all statuses)'
    renderNudges -> nudges 'bare_infra_citation_nudges(adrs)'
    nudges -> fanout 'counted non-live citers too'
    nudges -> isSharedInfra 'allowlist OR inflated fan-out'
    nudges -> renderNudges 'CitationNudge rows incl. Superseded ADRs'
    renderNudges -> runner 'markdown table'
    runner -> xref 'writes adr_xref.md'
  }

  dynamic view nudgeFlowFixed {
    title 'Nudge generation flow — current (post-#10565)'
    runner -> renderNudges 'arch-regen'
    renderNudges -> adrs 'full corpus (all statuses)'
    renderNudges -> nudges 'bare_infra_citation_nudges(adrs)'
    nudges -> isLive 'filters adr_list to live ADRs first'
    nudges -> fanout 'live-only fan-out count'
    nudges -> isSharedInfra 'allowlist OR live fan-out'
    nudges -> renderNudges 'CitationNudge rows, live ADRs only'
    renderNudges -> runner 'markdown table'
    runner -> xref 'writes adr_xref.md'
  }

  dynamic view driftFlow {
    title 'Drift suppression flow — live-only by construction'
    auditorLoop -> computeDrift 'merged PR file list'
    computeDrift -> adrsTouching 'src/ paths'
    adrsTouching -> computeDrift 'Accepted/Proposed ADRs only'
    computeDrift -> fanout 'live bare-citer count'
    computeDrift -> citationDrifts 'per (adr, path)'
    citationDrifts -> isSharedInfra 'suppress?'
    citationDrifts -> computeDrift 'DriftFinding or nothing'
  }
}
