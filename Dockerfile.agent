# Dockerfile.agent — Hydra agent container image
#
# Self-contained: builds everything from scratch by default.
# When the pre-built base image exists, pass --build-arg to skip the
# heavy stages and rebuild in seconds:
#
#   docker build -f Dockerfile.agent \
#     --build-arg BASE_IMAGE=ghcr.io/t-rav/hydraflow-agent-base:latest \
#     -t ghcr.io/t-rav/hydraflow-agent:latest .
#
# Test:  docker run --rm ghcr.io/t-rav/hydraflow-agent:latest bash /opt/hydraflow/docker-smoke-test.sh

# Global ARG — must be before the first FROM to be usable in FROM lines
ARG BASE_IMAGE=default-base

# ---------------------------------------------------------------------------
# Stage 1: base — system packages + Node.js + gh CLI + uv
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS base

ENV DEBIAN_FRONTEND=noninteractive

# Install system packages (ripgrep is needed by Claude CLI's Grep tool)
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        make \
        curl \
        gnupg \
        ca-certificates \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20.x via NodeSource.
# The NodeSource CDN intermittently 403s on BOTH setup_20.x and its package
# repo. (1) Retry the setup-script fetch with backoff. (2) When the NodeSource
# *package* repo is unreachable during apt install, apt silently falls back to
# Debian's `nodejs` — which does NOT bundle npm (Debian ships npm separately),
# so a later `npm install -g` dies with exit 127. So guarantee npm regardless
# of which nodejs won, then verify BOTH binaries so a half-install fails loudly
# HERE, not three steps later.
RUN for i in 1 2 3 4 5; do \
        curl -fsSL https://deb.nodesource.com/setup_20.x -o /tmp/nodesource_setup.sh && break; \
        echo "NodeSource fetch attempt $i failed (CDN 403/5xx); retrying in $((i * 5))s"; \
        sleep $((i * 5)); \
    done \
    && bash /tmp/nodesource_setup.sh \
    && apt-get install -y --no-install-recommends nodejs \
    && { command -v npm >/dev/null 2>&1 || apt-get install -y --no-install-recommends npm; } \
    && node --version && npm --version \
    && rm -rf /var/lib/apt/lists/* /tmp/nodesource_setup.sh

# Install gh CLI via official APT repo
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# Install uv (astral package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv \
    && mv /root/.local/bin/uvx /usr/local/bin/uvx

# ---------------------------------------------------------------------------
# Stage 2: tools — Agent CLIs + Python dev dependencies
# ---------------------------------------------------------------------------
FROM base AS tools

# Install agent CLIs globally via npm (Claude, Codex, Gemini, Pi)
RUN npm install -g @anthropic-ai/claude-code @openai/codex @google/gemini-cli @mariozechner/pi-coding-agent --no-fund --no-audit

# Pre-clone Claude Code plugins into /opt/plugins/ (strip .git to save image space)
RUN git clone --depth 1 https://github.com/anthropics/claude-plugins-official.git /opt/plugins/claude-plugins-official \
    && git clone --depth 1 https://github.com/obra/superpowers.git /opt/plugins/superpowers \
    && git clone --depth 1 https://github.com/8thlight/lightfactory.git /opt/plugins/lightfactory \
    && rm -rf /opt/plugins/*/.git

# Pre-install Python quality tools into a venv.
# Extras: test + dev + docker (the factory runs `make quality` in worktrees).
# The `docs` extra (mkdocs + heavy mkdocs-material) is deliberately EXCLUDED —
# the agent never builds the docs *site* (that is a CI Pages step / `make
# arch-serve` for local dev); shipping it wasted image budget and chronically
# pinned this image against the 2 GB cap (#11004).
COPY pyproject.toml uv.lock ./
RUN uv venv /opt/hydraflow-venv \
    && UV_PROJECT_ENVIRONMENT=/opt/hydraflow-venv uv sync --extra test --extra dev --extra docker --no-install-project

# ---------------------------------------------------------------------------
# Stage 3: default-base — full build from scratch (skipped when BASE_IMAGE is set)
# ---------------------------------------------------------------------------
FROM base AS default-base

# Copy Node.js global packages (Claude, Codex, Gemini, Pi CLIs)
COPY --from=tools /usr/lib/node_modules /usr/lib/node_modules
COPY --from=tools /usr/bin/claude /usr/bin/claude
RUN ln -s ../lib/node_modules/@openai/codex/bin/codex.js /usr/bin/codex \
    && ln -s ../lib/node_modules/@google/gemini-cli/bundle/gemini.js /usr/bin/gemini \
    && ln -s ../lib/node_modules/@mariozechner/pi-coding-agent/dist/cli.js /usr/bin/pi

# Copy Python venv with quality tools
COPY --from=tools /opt/hydraflow-venv /opt/hydraflow-venv

# Copy pre-cloned Claude Code plugins (readable by non-root user)
COPY --from=tools /opt/plugins /opt/plugins

# Create non-root user
RUN groupadd --gid 1000 hydraflow \
    && useradd --uid 1000 --gid hydraflow --create-home hydraflow \
    && mkdir -p /workspace /tmp \
    && chown hydraflow:hydraflow /workspace \
    && chown -R hydraflow:hydraflow /opt/plugins

# Configure PATH
ENV PATH="/opt/hydraflow-venv/bin:${PATH}"
ENV VIRTUAL_ENV=/opt/hydraflow-venv

# Configure git safe directory for mounted workspaces
RUN git config --system --add safe.directory /workspace

# Symlink system ripgrep to where Claude CLI expects its bundled binary.
RUN ARCH=$(dpkg --print-architecture) \
    && mkdir -p /usr/bin/vendor/ripgrep/${ARCH}-linux \
    && ln -s /usr/bin/rg /usr/bin/vendor/ripgrep/${ARCH}-linux/rg

WORKDIR /workspace
USER hydraflow

# ---------------------------------------------------------------------------
# Stage 4: runtime — use pre-built base if available, otherwise default-base
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS runtime

# A pre-built base may predate the JSONL-only task-store contract. Remove the
# unsupported database task client and module explicitly so selecting that
# base cannot silently reintroduce a shared-store execution path.
USER root
RUN rm -f /usr/bin/bd /usr/local/bin/bd \
    && rm -rf /usr/lib/node_modules/@beads/bd /usr/local/lib/node_modules/@beads/bd
USER hydraflow

# Copy smoke test script
COPY scripts/docker-smoke-test.sh /opt/hydraflow/docker-smoke-test.sh

# Copy application source so the sandbox entrypoint
# (`python -m mockworld.sandbox_main ...`) can import without an editable
# install. PYTHONPATH points at this location. /workspace is reserved for
# bind mounts (worktrees in production, repo fixtures in sandbox), so the
# sources live separately under /opt/hydraflow/src.
#
# `tests/` is copied alongside `src/` because contract_diff.py imports
# `tests.trust.contracts._schema` at module load time (the schema lives
# next to its consumers in tests/). PYTHONPATH includes /opt/hydraflow
# so `tests.*` resolves.
COPY --chown=hydraflow:hydraflow src /opt/hydraflow/src
COPY --chown=hydraflow:hydraflow tests /opt/hydraflow/tests
COPY --chown=hydraflow:hydraflow templates /opt/hydraflow/templates
COPY --chown=hydraflow:hydraflow static /opt/hydraflow/static
ENV PYTHONPATH=/opt/hydraflow/src:/opt/hydraflow

CMD ["bash"]
