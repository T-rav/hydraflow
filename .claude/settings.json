{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.block-destructive-git.sh",
            "timeout": 10,
            "statusMessage": "Checking for destructive git commands...",
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.scan-secrets-before-commit.sh",
            "timeout": 30,
            "statusMessage": "Scanning for secrets in staged files...",
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.validate-tests-before-commit.sh",
            "timeout": 120,
            "statusMessage": "Validating lint + tests before commit...",
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.validate-functional-areas.sh",
            "timeout": 30,
            "statusMessage": "Validating functional-areas schema...",
            "_hydraflow": true
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.enforce-plan-and-explore.sh",
            "timeout": 10,
            "statusMessage": "Checking for exploration and planning...",
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.check-test-counterpart.sh",
            "timeout": 10,
            "statusMessage": "Checking for test counterpart...",
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.enforce-migrations.sh",
            "timeout": 10,
            "statusMessage": "Checking for direct DB schema changes...",
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.check-cross-service-impact.sh",
            "timeout": 15,
            "statusMessage": "Checking cross-service impact for shared/ changes...",
            "_hydraflow": true
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.enforce-plan-and-explore.sh",
            "timeout": 10,
            "statusMessage": "Checking for exploration and planning...",
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.check-test-counterpart.sh",
            "timeout": 10,
            "statusMessage": "Checking for test counterpart...",
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.enforce-migrations.sh",
            "timeout": 10,
            "statusMessage": "Checking for direct DB schema changes...",
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.check-cross-service-impact.sh",
            "timeout": 15,
            "statusMessage": "Checking cross-service impact for shared/ changes...",
            "_hydraflow": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.track-exploration.sh",
            "timeout": 5,
            "_hydraflow": true
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.track-exploration.sh",
            "timeout": 5,
            "_hydraflow": true
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.track-exploration.sh",
            "timeout": 5,
            "_hydraflow": true
          }
        ]
      },
      {
        "matcher": "cclsp",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.track-exploration.sh",
            "timeout": 5,
            "_hydraflow": true
          }
        ]
      },
      {
        "matcher": "TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.track-planning.sh",
            "timeout": 5,
            "_hydraflow": true
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.warn-new-file-creation.sh",
            "timeout": 10,
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.track-code-changes.sh",
            "timeout": 5,
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.auto-lint-after-edit.sh",
            "timeout": 15,
            "statusMessage": "Auto-fixing lint issues...",
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.mirror-feedback-memory.sh",
            "timeout": 15,
            "statusMessage": "Mirroring feedback memory to in-repo backlog...",
            "_hydraflow": true
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.track-code-changes.sh",
            "timeout": 5,
            "_hydraflow": true
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.auto-lint-after-edit.sh",
            "timeout": 15,
            "statusMessage": "Auto-fixing lint issues...",
            "_hydraflow": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hf.cleanup-code-change-marker.sh",
            "timeout": 5,
            "_hydraflow": true
          }
        ]
      }
    ]
  }
}
